# The TelegramMessenger/Telegram-iOS release Pluma is built from: the tag
# release-13.2, pinned by its commit. ci/patch.py checks that the checkout
# matches these values; an update changes them together.
UPSTREAM_REPO=https://github.com/TelegramMessenger/Telegram-iOS.git
UPSTREAM_TAG=release-13.2
UPSTREAM_REF=24638bc69bd083981b178dd1e7f921eebbf7fc46
UPSTREAM_VERSION=13.2
UPSTREAM_LAYER=233
# The toolchain of its versions.json. Make.py refuses any other Xcode and
# downloads this Bazel itself (checking the SHA-256 versions.json gives).
XCODE_VERSION=27.1
BAZEL_VERSION=9.2.0
