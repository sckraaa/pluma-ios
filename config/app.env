# Identity of the Pluma iOS app. ci/patch.py writes it into the build
# configuration Make.py reads; the extensions are <bundle ID>.<name> and the
# App Group is group.<bundle ID> (README, Signing).
PLUMA_BUNDLE_ID=chat.pluma.app
PLUMA_APP_NAME=Pluma
# The scheme of the app's links, Pluma's tg://: the app registers it, opens
# its links and makes them (the QR code of a sign-in, the widget, the share
# extension), so that they do not open Telegram installed on the same phone.
# Telegram's tg:// is not registered. The same in every Pluma client.
PLUMA_URL_SCHEME=plm
# api_id and api_hash identify the app to the server (not secrets: every
# client carries them). Pluma: 10001 Android, 10002 iOS, 10003 Desktop, 10004 Web.
PLUMA_API_ID=10002
PLUMA_API_HASH=f25c102168e1b20e51a4f8e90abebaa4
# The Make.py configuration of the simulator build: debug_sim_arm64, or
# release_sim_arm64 for an optimized build without debug assertions.
PLUMA_SIM_CONFIGURATION=debug_sim_arm64
