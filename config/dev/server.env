# A development server: the Mac that runs both the iOS Simulator and the
# server repository's docker compose stack (the Simulator shares the Mac's
# network). Builds for a real server take the address and the key from the
# repository variables (README).
PLUMA_SERVER_IPV4=127.0.0.1
PLUMA_SERVER_PORT=10443
# Simulator builds are not signed by a team; Make.py still needs a Team ID.
PLUMA_TEAM_ID=0000000000
